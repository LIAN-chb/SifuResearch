# Track authored research management/source and layout configuration, not derived data.
/*
!/.gitignore
!/.gitattributes
!/AGENTS.md
!/PROJECT.md
!/README.md
!/adr/
!/notes/
!/scripts/
!/Sifu/
!/tools/
/tools/*
!/tools/local_bounded_packages.py
!/inventory/
/inventory/*
!/inventory/vault-layout.json
!/exports/
/exports/**
!/exports/**/
!/exports/**/*.py

# Historical backups and machine-local/generated state stay on disk.
**/backup/
**/backups/
/notes/vault-backups/
/Sifu/.obsidian/
**/__pycache__/
*.pyc
*.pyo
*.tmp
*.bak
*.bak-*
*.exe
*.dll
*.pdb
*.pak
*.uasset
*.uexp
*.ubulk
*.zip
*.gz
.env
.env.*
**/credentials.json
